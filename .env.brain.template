# MindrianOS Brain -- Connection Credentials
# Copy this file to .env.brain and fill in your values.
#
# HTTP path (Phase 123 Plan-07, the standard CLI install).
# Auth: Authorization: Bearer <key>  (NOT x-api-key -- the server returns 401
# on x-api-key requests and links to https://mindrian-os.com/brain-access)
# Request a key: https://mindrian-os.com/brain-access
# Override URL: MINDRIAN_BRAIN_URL=https://your-host (default
# https://pws-brain-mcp.onrender.com -- the ONE canon store; the retired
# mindrian-brain.onrender.com replica is suspended and answers nothing)
#
# For the HTTP path, the ONLY required variable is MINDRIAN_BRAIN_KEY below.
# Write it to ~/.mindrian.env (chmod 600 -- SEC-02; /mos:setup brain does this
# for you) and lib/core/resolve-brain-key.cjs will find it on every session.
# Do NOT need the Supabase / Neo4j / Pinecone variables for the HTTP path.
#
# MCP path (optional, legacy/advanced). Add the Brain MCP server to your
# claude_desktop_config.json (or personal .mcp.json) under the canonical name
# `mindrian-brain` and pass the variables below through. See
# docs/install/BRAIN-SETUP.md for the full MCP-path wiring.
#
# Phase 94-04 (v1.11.2): the bundled mcp-server-brain/ is now optional.
# v1.11.2 defaults to users pointing `mindrian-brain` at their own Neo4j
# MCP. The bundled server remains buildable for advanced users; if you
# choose that path, populate the values below.

# Supabase project URL hosting the Brain key/auth DB
SUPABASE_URL=

# Supabase service-role key (NEVER share publicly)
SUPABASE_KEY=

# Per-user secret token validating queries against your Brain.
# When this is set but no `mindrian-brain` MCP server resolves in your
# .mcp.json, scripts/session-start emits a yellow WARN line to surface
# the misconfiguration instead of falling silently into Tier 0.
MINDRIAN_BRAIN_KEY=

# Neo4j connection (bolt:// or neo4j+s://). From Aura console -> Connection.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Pinecone API key for the semantic-search-records tool surface.
# From Pinecone console -> API Keys.
PINECONE_API_KEY=
