# User workspace (private data)
room/
export/

# Dashboard generated data
dashboard/graph.json

# Context bridge temp files
/tmp/mindrian-*

# SQLite auxiliary files (WAL mode)
*.db-wal
*.db-shm

# Phase 84-03: per-room memory runtime state. Real rooms live outside the
# repo at ~/MindrianRooms/<name>, but any in-repo fixture or cache must
# never commit room.db, the session pointer, or WAL shards.
.mindrian/
**/.mindrian/current-session.json
# Phase 99-01 exception: the conversation-operator fixture committs deterministic
# state files (cold-start .gitkeep + resume conversation-operator.json) needed
# by tests/test-operator-state.cjs. Hook side-channel artifacts
# (auto-commit-throttle.json, last-cascade.json, pending-stamps/) remain ignored.
!test/fixtures/conversation-operator/seed-room/.mindrian/
!test/fixtures/conversation-operator/seed-room/.mindrian/.gitkeep
!test/fixtures/conversation-operator/seed-room-resume/.mindrian/
!test/fixtures/conversation-operator/seed-room-resume/.mindrian/conversation-operator.json

# Phase 115-02: test stubs auto-generated by lib/core/shallow-doc-parser.test.cjs
# at every run. Deterministic content; not committed to keep churn low.
lib/core/__nav-stub.cjs

# Environment and secrets
.env
.env.local
.mcp.json
*.key

# Python
__pycache__/
*.pyc

# OS files
.DS_Store
Thumbs.db

