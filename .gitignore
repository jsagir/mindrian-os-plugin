# User workspace (private data)
room/
export/

# Dashboard generated data
dashboard/graph.json

# Context bridge temp files
/tmp/mindrian-*

# SQLite auxiliary files (WAL mode)
*.db-wal
*.db-shm

# Phase 84-03: per-room memory runtime state. Real rooms live outside the
# repo at ~/MindrianRooms/<name>, but any in-repo fixture or cache must
# never commit room.db, the session pointer, or WAL shards.
.mindrian/
**/.mindrian/current-session.json

# Environment and secrets
.env
.env.local
.mcp.json
*.key

# Python
__pycache__/
*.pyc

# OS files
.DS_Store
Thumbs.db

# Brain MCP server (standalone deploy)
mcp-server-brain/node_modules/
mcp-server-brain/package-lock.json

# Planning (development only)
.planning/
node_modules/
.claude/worktrees/
.superpowers/
