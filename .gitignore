# User workspace (private data). Anchored to repo root (Phase quick-260705-ob7):
# an unanchored pattern also matched skills/room/ and skills/export/ -- the
# build-skill-mirrors.cjs generated command mirrors -- silently dropping them
# from every commit with no gate catching it (gates check the filesystem, not
# git-tracking status).
/room/
/export/

# Dashboard generated data. Untracked 2026-08-19 (Quick Task 260819-dmm): this
# file is generated per-room by scripts/build-graph, whose OUTPUT_PATH default
# is CWD-relative (./dashboard/graph.json on both the python and bash
# branches). While it stayed tracked, every repo-cwd cascade run (Step 9 in
# lib/core/intelligence-cascade.cjs) rewrote it with a temp-fixture room's
# graph plus a fresh generatedAt, which aborted the release clean-tree
# pre-flight (doctor.cjs verify-release-clean-tree, scripts/verify-release).
# The committed bytes were themselves a 2026-07-15 /tmp fixture snapshot
# shipped to every install. Never re-add this path to the index; the pattern
# below only takes effect once the path is absent from git's tracked files.
dashboard/graph.json

# Phase 198 two-host parity leg captures (runtime output; the canonical
# expected transcript is committed in evals/plurai/198-baseline.json)
tests/artifacts/

# Context bridge temp files
/tmp/mindrian-*

# SQLite auxiliary files (WAL mode)
*.db-wal
*.db-shm

# Phase 84-03: per-room memory runtime state. Real rooms live outside the
# repo at ~/MindrianRooms/<name>, but any in-repo fixture or cache must
# never commit room.db, the session pointer, or WAL shards.
room.db
room.db-wal
room.db-shm
**/room.db
**/room.db-wal
**/room.db-shm
.mindrian/
**/.mindrian/current-session.json
# Phase 272-08: rs-engine.cjs runtime artifacts written directly into a
# room's root (not inside .mindrian/) -- results + embedding cache, never
# committed for any room including the Phase 272 fixture room.
**/.rs-engine-results.json
**/.rs-engine-cache.json
# Phase 272-09: hsi-engine.cjs's own results file, same runtime-artifact
# class as rs-engine.cjs's above -- never committed for any room including
# the Phase 272 fixture room.
**/.hsi-results.json
# Phase 99-01 exception: the conversation-operator fixture committs deterministic
# state files (cold-start .gitkeep + resume conversation-operator.json) needed
# by tests/test-operator-state.cjs. Hook side-channel artifacts
# (auto-commit-throttle.json, last-cascade.json, pending-stamps/) remain ignored.
!test/fixtures/conversation-operator/seed-room/.mindrian/
!test/fixtures/conversation-operator/seed-room/.mindrian/.gitkeep
!test/fixtures/conversation-operator/seed-room-resume/.mindrian/
!test/fixtures/conversation-operator/seed-room-resume/.mindrian/conversation-operator.json

# Phase 115-02: test stubs auto-generated by lib/core/shallow-doc-parser.test.cjs
# at every run. Deterministic content; not committed to keep churn low.
lib/core/__nav-stub.cjs

# Environment and secrets
.env
.env.local
.mcp.json
*.key

# Phase 234-07: dist/ is GENERATED (scripts/build-dist-bundles.cjs) and COMMITTED,
# matching how data/connector-registry.json -- also generated, also never
# hand-edited -- is tracked in this repo. Never hand-edit anything under dist/.
#
# The ONE deliberate exception is dist/generic-claude-dir/.mcp.json, already
# caught by the unanchored `.mcp.json` rule directly above. That is intentional,
# not an accident of pattern ordering: no foreign host expands
# ${CLAUDE_PLUGIN_ROOT}, so the generated variant bakes in a LITERAL absolute
# install path resolved on whatever machine ran the generator. Committing it
# would publish the maintainer's home directory and hand every other user a path
# that is wrong for them. Do NOT "fix" this with a `!dist/**/.mcp.json` negation;
# run the generator locally instead. dist/README.md says the same thing to users.

# Python
__pycache__/
*.pyc

