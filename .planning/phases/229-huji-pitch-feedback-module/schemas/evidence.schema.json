{
  "type": "object",
  "properties": {
    "submission_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_claim": {
      "type": "object",
      "properties": {
        "stated": {
          "type": "boolean"
        },
        "quote": {
          "type": "string"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d+:\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stated",
        "quote",
        "timestamp"
      ],
      "additionalProperties": false
    },
    "value_proposition": {
      "type": "object",
      "properties": {
        "stated": {
          "type": "boolean"
        },
        "quote": {
          "type": "string"
        }
      },
      "required": [
        "stated",
        "quote"
      ],
      "additionalProperties": false
    },
    "evidence_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "evidenced": {
            "type": "string",
            "enum": [
              "evidenced",
              "asserted",
              "absent"
            ]
          }
        },
        "required": [
          "claim",
          "quote",
          "evidenced"
        ],
        "additionalProperties": false
      }
    },
    "self_identified_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "speaker_count": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "language_notes": {
      "type": "string"
    }
  },
  "required": [
    "submission_id",
    "problem_claim",
    "value_proposition",
    "evidence_claims",
    "self_identified_gaps",
    "speaker_count",
    "language_notes"
  ],
  "additionalProperties": false
}
