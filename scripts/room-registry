#!/usr/bin/env bash
# room-registry -- Registry CRUD operations for multi-room management
# Manages .rooms/registry.json with atomic writes (tmp + mv)
#
# Default registry location: $MINDRIAN_ROOMS_HOME/.rooms/registry.json
# (was $WORK_DIR/.rooms/registry.json in v1 -- kept for backward compat)
#
# Subcommands:
#   create <name> <path> [venture_name] [venture_stage]
#   read <name>
#   list
#   update <name> <field> <value>
#   set-active <name>
#   archive <name>
#   get-active
#   git-config <name> <git_enabled> [git_remote] [auto_push] [vercel_url]
#
# First positional argument (before subcommand) can be a directory to override
# ROOMS_HOME for that invocation. Defaults to $MINDRIAN_ROOMS_HOME or ~/MindrianRooms.
#
# Phase 128.1 (session-scoped active-room binding): the create / set-active /
# archive subcommands are session-scoped writes. Each writes the racing global
# fields (active / last_active) AND a session-keyed sessions[sessionId] entry,
# under an os.mkdir directory lock on registry.json.lock so two concurrent
# sessions never clobber each other's binding (D-02/D-03/D-06).
#   Session id: $CLAUDE_SESSION_ID, then $session_id, then a sess-<ts> fallback.
#   A leading `--session <id>` arg overrides it (used by hermetic test fixtures).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Central rooms location (new default)
ROOMS_HOME="${MINDRIAN_ROOMS_HOME:-$HOME/MindrianRooms}"

# Parse optional directory override -- if first arg is a directory, use it
if [ $# -ge 1 ] && [ -d "$1" ]; then
  ROOMS_HOME="$1"
  shift
fi

# Phase 128.1: optional `--session <id>` override (test fixtures set it).
SESSION_ID_OVERRIDE=""
if [ $# -ge 2 ] && [ "$1" = "--session" ]; then
  SESSION_ID_OVERRIDE="$2"
  shift 2
fi

REGISTRY_DIR="${ROOMS_HOME}/.rooms"
REGISTRY_FILE="${REGISTRY_DIR}/registry.json"

# Phase 128.1: resolve the canonical session id. Mirrors scripts/pre-compact /
# scripts/on-stop -- CLAUDE_SESSION_ID, then the lowercase statusline env, then
# a sess-<timestamp> cold-start fallback. The --session override wins. Never
# empty so every session-scoped write keys into a stable sessions[] slot.
ROOM_REGISTRY_SESSION_ID="$SESSION_ID_OVERRIDE"
if [ -z "$ROOM_REGISTRY_SESSION_ID" ]; then
  ROOM_REGISTRY_SESSION_ID="${CLAUDE_SESSION_ID:-}"
fi
if [ -z "$ROOM_REGISTRY_SESSION_ID" ]; then
  ROOM_REGISTRY_SESSION_ID="${session_id:-}"
fi
if [ -z "$ROOM_REGISTRY_SESSION_ID" ]; then
  ROOM_REGISTRY_SESSION_ID="sess-$(date +%s)"
fi
export ROOM_REGISTRY_SESSION_ID

SUBCMD="${1:-}"
shift 2>/dev/null || true

ensure_registry() {
  mkdir -p "$ROOMS_HOME"
  mkdir -p "$REGISTRY_DIR"
  if [ ! -f "$REGISTRY_FILE" ]; then
    echo '{"version": 1, "active": "", "rooms": {}}' > "$REGISTRY_FILE"
  fi
}

case "$SUBCMD" in
  create)
    NAME="${1:-}"
    RPATH="${2:-}"
    VNAME="${3:-My Venture}"
    VSTAGE="${4:-Pre-Opportunity}"
    if [ -z "$NAME" ] || [ -z "$RPATH" ]; then
      echo "[MindrianOS] Cannot create room -- missing name or path." >&2
      echo "  Why: Both a room name and path are required to create a room" >&2
      echo "  Fix: Run /mos:new-project to create a room interactively" >&2
      exit 1
    fi
    ensure_registry
    python3 -c "
import json, os, datetime, time

reg_file = '$REGISTRY_FILE'
session_id = os.environ.get('ROOM_REGISTRY_SESSION_ID', '')
lock_dir = reg_file + '.lock'
LOCK_TTL = 2.0
RETRY_BUDGET = 0.2


def acquire_lock():
    started = time.time()
    while time.time() - started < RETRY_BUDGET:
        try:
            os.mkdir(lock_dir)
            return True
        except FileExistsError:
            try:
                if time.time() - os.path.getmtime(lock_dir) > LOCK_TTL:
                    try:
                        os.rmdir(lock_dir)
                    except OSError:
                        pass
                    continue
            except OSError:
                pass
            time.sleep(0.005)
        except OSError:
            return False
    return False


def release_lock(held):
    if held:
        try:
            os.rmdir(lock_dir)
        except OSError:
            pass


def migrate_v3(reg):
    # Additive v2 -> v3 migration (Phase 128.1): adds sessions + last_active;
    # keeps the legacy active string as a mirror (D-04).
    if not isinstance(reg.get('version'), int) or reg.get('version') < 3:
        reg['sessions'] = reg.get('sessions') or {}
        reg['last_active'] = reg.get('last_active') or reg.get('active') or ''
        reg['version'] = 3
    return reg


held = acquire_lock()
try:
    with open(reg_file) as f:
        reg = json.load(f)
    reg = migrate_v3(reg)
    reg['sessions'] = reg.get('sessions') or {}
    # Park currently active room
    old_active = reg.get('active', '')
    if old_active and old_active in reg.get('rooms', {}):
        reg['rooms'][old_active]['status'] = 'parked'
    now = datetime.datetime.now(datetime.UTC).strftime('%Y-%m-%dT%H:%M:%SZ')
    reg['rooms']['$NAME'] = {
        'path': '$RPATH',
        'created': now,
        'last_opened': now,
        'status': 'active',
        'venture_name': '''$VNAME''',
        'venture_stage': '''$VSTAGE''',
        'git_enabled': 'false',
        'git_remote': '',
        'auto_push': 'off',
        'vercel_url': ''
    }
    # Session-scoped write: bind THIS session to the new room, plus the
    # last_active + active legacy mirrors (D-02 / D-04).
    if session_id:
        reg['sessions'][session_id] = {
            'room': '$NAME',
            'bound_at': now,
            'last_seen_at': now,
        }
    reg['last_active'] = '$NAME'
    reg['active'] = '$NAME'
    tmp = reg_file + '.tmp.' + str(os.getpid())
    with open(tmp, 'w') as f:
        json.dump(reg, f, indent=2)
    os.rename(tmp, reg_file)
    print(json.dumps(reg['rooms']['$NAME'], indent=2))
finally:
    release_lock(held)
"
    # Create the room directory under ROOMS_HOME
    mkdir -p "${ROOMS_HOME}/${RPATH}"
    # Fire-and-forget graph sync (D-16: never blocks)
    node "${SCRIPT_DIR}/sync-rooms-graph" "$ROOMS_HOME" >/dev/null 2>&1 &
    node "${SCRIPT_DIR}/sync-rooms-brain" "$ROOMS_HOME" >/dev/null 2>&1 &
    ;;

  read)
    NAME="${1:-}"
    if [ -z "$NAME" ]; then
      echo "[MindrianOS] Cannot read room -- no name provided." >&2
      echo "  Why: You need to specify which room to read" >&2
      echo "  Fix: Run /mos:rooms to see your rooms, then try again with a name" >&2
      exit 1
    fi
    if [ ! -f "$REGISTRY_FILE" ]; then
      echo "[MindrianOS] No room registry found." >&2
      echo "  Why: No rooms have been created yet at ${ROOMS_HOME}/" >&2
      echo "  Fix: Run /mos:new-project to create your first room" >&2
      echo "{}" ; exit 1
    fi
    python3 -c "
import json, sys
with open('$REGISTRY_FILE') as f:
    reg = json.load(f)
room = reg.get('rooms', {}).get('$NAME')
if room:
    print(json.dumps(room, indent=2))
else:
    print('{}')
    sys.exit(1)
"
    ;;

  list)
    if [ ! -f "$REGISTRY_FILE" ]; then
      echo "[]" ; exit 0
    fi
    python3 -c "
import json
with open('$REGISTRY_FILE') as f:
    reg = json.load(f)
result = []
for name, room in reg.get('rooms', {}).items():
    result.append({
        'name': name,
        'path': room.get('path', ''),
        'status': room.get('status', 'unknown'),
        'venture_name': room.get('venture_name', ''),
        'venture_stage': room.get('venture_stage', ''),
        'last_opened': room.get('last_opened', ''),
        'git_enabled': room.get('git_enabled', 'false'),
        'auto_push': room.get('auto_push', 'off')
    })
print(json.dumps(result, indent=2))
"
    ;;

  update)
    NAME="${1:-}"
    FIELD="${2:-}"
    VALUE="${3:-}"
    if [ -z "$NAME" ] || [ -z "$FIELD" ]; then
      echo "[MindrianOS] Cannot update room -- missing name or field." >&2
      echo "  Why: Both a room name and field name are required" >&2
      echo "  Fix: Run /mos:rooms to see your rooms" >&2
      exit 1
    fi
    if [ ! -f "$REGISTRY_FILE" ]; then
      echo "[MindrianOS] No room registry found." >&2
      echo "  Why: No rooms have been created yet" >&2
      echo "  Fix: Run /mos:new-project to create your first room" >&2
      exit 1
    fi
    python3 -c "
import json, os, sys
reg_file = '$REGISTRY_FILE'
with open(reg_file) as f:
    reg = json.load(f)
if '$NAME' not in reg.get('rooms', {}):
    print('[MindrianOS] Room not found: $NAME', file=sys.stderr); print('  Fix: Run /mos:rooms to see available rooms', file=sys.stderr)
    sys.exit(1)
reg['rooms']['$NAME']['$FIELD'] = '''$VALUE'''
tmp = reg_file + '.tmp'
with open(tmp, 'w') as f:
    json.dump(reg, f, indent=2)
os.rename(tmp, reg_file)
print(json.dumps(reg['rooms']['$NAME'], indent=2))
"
    ;;

  set-active)
    NAME="${1:-}"
    if [ -z "$NAME" ]; then
      echo "[MindrianOS] Cannot activate room -- no name provided." >&2
      echo "  Why: You need to specify which room to switch to" >&2
      echo "  Fix: Run /mos:rooms to see available rooms" >&2
      exit 1
    fi
    if [ ! -f "$REGISTRY_FILE" ]; then
      echo "[MindrianOS] No room registry found." >&2
      echo "  Why: No rooms have been created yet" >&2
      echo "  Fix: Run /mos:new-project to create your first room" >&2
      exit 1
    fi
    python3 -c "
import json, os, sys, datetime, time

reg_file = '$REGISTRY_FILE'
session_id = os.environ.get('ROOM_REGISTRY_SESSION_ID', '')
lock_dir = reg_file + '.lock'
LOCK_TTL = 2.0
RETRY_BUDGET = 0.2


def acquire_lock():
    started = time.time()
    while time.time() - started < RETRY_BUDGET:
        try:
            os.mkdir(lock_dir)
            return True
        except FileExistsError:
            try:
                if time.time() - os.path.getmtime(lock_dir) > LOCK_TTL:
                    try:
                        os.rmdir(lock_dir)
                    except OSError:
                        pass
                    continue
            except OSError:
                pass
            time.sleep(0.005)
        except OSError:
            return False
    return False


def release_lock(held):
    if held:
        try:
            os.rmdir(lock_dir)
        except OSError:
            pass


def migrate_v3(reg):
    if not isinstance(reg.get('version'), int) or reg.get('version') < 3:
        reg['sessions'] = reg.get('sessions') or {}
        reg['last_active'] = reg.get('last_active') or reg.get('active') or ''
        reg['version'] = 3
    return reg


held = acquire_lock()
try:
    with open(reg_file) as f:
        reg = json.load(f)
    if '$NAME' not in reg.get('rooms', {}):
        print('[MindrianOS] Room not found: $NAME', file=sys.stderr)
        print('  Fix: Run /mos:rooms to see available rooms', file=sys.stderr)
        release_lock(held)
        sys.exit(1)
    reg = migrate_v3(reg)
    reg['sessions'] = reg.get('sessions') or {}
    # Park currently active room
    old_active = reg.get('active', '')
    if old_active and old_active in reg.get('rooms', {}) and old_active != '$NAME':
        reg['rooms'][old_active]['status'] = 'parked'
    now = datetime.datetime.now(datetime.UTC).strftime('%Y-%m-%dT%H:%M:%SZ')
    reg['rooms']['$NAME']['status'] = 'active'
    reg['rooms']['$NAME']['last_opened'] = now
    # Session-scoped write (D-02): bind THIS session to the room, plus the
    # last_active + active legacy mirrors (D-04, never removed).
    if session_id:
        reg['sessions'][session_id] = {
            'room': '$NAME',
            'bound_at': now,
            'last_seen_at': now,
        }
    reg['last_active'] = '$NAME'
    reg['active'] = '$NAME'
    tmp = reg_file + '.tmp.' + str(os.getpid())
    with open(tmp, 'w') as f:
        json.dump(reg, f, indent=2)
    os.rename(tmp, reg_file)
    print('$NAME')
finally:
    release_lock(held)
"
    ;;

  archive)
    NAME="${1:-}"
    if [ -z "$NAME" ]; then
      echo "[MindrianOS] Cannot archive room -- no name provided." >&2
      echo "  Why: You need to specify which room to archive" >&2
      echo "  Fix: Run /mos:rooms to see your rooms" >&2
      exit 1
    fi
    if [ ! -f "$REGISTRY_FILE" ]; then
      echo "[MindrianOS] No room registry found." >&2
      echo "  Why: No rooms have been created yet" >&2
      echo "  Fix: Run /mos:new-project to create your first room" >&2
      exit 1
    fi
    python3 -c "
import json, os, sys, time

reg_file = '$REGISTRY_FILE'
lock_dir = reg_file + '.lock'
LOCK_TTL = 2.0
RETRY_BUDGET = 0.2


def acquire_lock():
    started = time.time()
    while time.time() - started < RETRY_BUDGET:
        try:
            os.mkdir(lock_dir)
            return True
        except FileExistsError:
            try:
                if time.time() - os.path.getmtime(lock_dir) > LOCK_TTL:
                    try:
                        os.rmdir(lock_dir)
                    except OSError:
                        pass
                    continue
            except OSError:
                pass
            time.sleep(0.005)
        except OSError:
            return False
    return False


def release_lock(held):
    if held:
        try:
            os.rmdir(lock_dir)
        except OSError:
            pass


def migrate_v3(reg):
    if not isinstance(reg.get('version'), int) or reg.get('version') < 3:
        reg['sessions'] = reg.get('sessions') or {}
        reg['last_active'] = reg.get('last_active') or reg.get('active') or ''
        reg['version'] = 3
    return reg


held = acquire_lock()
try:
    with open(reg_file) as f:
        reg = json.load(f)
    if '$NAME' not in reg.get('rooms', {}):
        print('[MindrianOS] Room not found: $NAME', file=sys.stderr)
        print('  Fix: Run /mos:rooms to see available rooms', file=sys.stderr)
        release_lock(held)
        sys.exit(1)
    reg = migrate_v3(reg)
    reg['rooms']['$NAME']['status'] = 'archived'
    if reg.get('active') == '$NAME':
        reg['active'] = ''
    if reg.get('last_active') == '$NAME':
        reg['last_active'] = ''
    # Session-scoped cleanup (D-02): clear every sessions[*] entry still bound
    # to the archived room so no session is left pointing at an archived room.
    sessions = reg.get('sessions') or {}
    for sid in list(sessions.keys()):
        entry = sessions.get(sid) or {}
        if entry.get('room') == '$NAME':
            del sessions[sid]
    reg['sessions'] = sessions
    tmp = reg_file + '.tmp.' + str(os.getpid())
    with open(tmp, 'w') as f:
        json.dump(reg, f, indent=2)
    os.rename(tmp, reg_file)
    print('archived')
finally:
    release_lock(held)
"
    # Fire-and-forget graph sync (D-16: never blocks)
    node "${SCRIPT_DIR}/sync-rooms-graph" "$ROOMS_HOME" >/dev/null 2>&1 &
    node "${SCRIPT_DIR}/sync-rooms-brain" "$ROOMS_HOME" >/dev/null 2>&1 &
    ;;

  get-active)
    if [ ! -f "$REGISTRY_FILE" ]; then
      echo ""; exit 0
    fi
    python3 -c "
import json
with open('$REGISTRY_FILE') as f:
    reg = json.load(f)
print(reg.get('active', ''))
"
    ;;

  git-config)
    NAME="${1:-}"
    GIT_ENABLED="${2:-false}"
    GIT_REMOTE="${3:-}"
    AUTO_PUSH="${4:-off}"
    VERCEL_URL="${5:-}"
    if [ -z "$NAME" ]; then
      echo "[MindrianOS] Cannot configure git -- no room name provided." >&2
      echo "  Why: You need to specify which room to configure" >&2
      echo "  Fix: Run /mos:rooms to see your rooms" >&2
      exit 1
    fi
    if [ ! -f "$REGISTRY_FILE" ]; then
      echo "[MindrianOS] No room registry found." >&2
      echo "  Why: No rooms have been created yet" >&2
      echo "  Fix: Run /mos:new-project to create your first room" >&2
      exit 1
    fi
    python3 -c "
import json, os, sys
reg_file = '$REGISTRY_FILE'
with open(reg_file) as f:
    reg = json.load(f)
if '$NAME' not in reg.get('rooms', {}):
    print('[MindrianOS] Room not found: $NAME', file=sys.stderr); print('  Fix: Run /mos:rooms to see available rooms', file=sys.stderr)
    sys.exit(1)
reg['rooms']['$NAME']['git_enabled'] = '''$GIT_ENABLED'''
reg['rooms']['$NAME']['git_remote'] = '''$GIT_REMOTE'''
reg['rooms']['$NAME']['auto_push'] = '''$AUTO_PUSH'''
reg['rooms']['$NAME']['vercel_url'] = '''$VERCEL_URL'''
tmp = reg_file + '.tmp'
with open(tmp, 'w') as f:
    json.dump(reg, f, indent=2)
os.rename(tmp, reg_file)
print(json.dumps(reg['rooms']['$NAME'], indent=2))
"
    ;;

  *)
    echo "[MindrianOS] Unknown room-registry command: '${SUBCMD}'" >&2
    echo "  Why: '${SUBCMD}' is not a valid subcommand" >&2
    echo "  Fix: Valid commands are: create, read, list, update, set-active, archive, get-active, git-config" >&2
    exit 1
    ;;
esac
