#!/usr/bin/env node
// MindrianOS Statusline - ships with the plugin
// Shows: project name │ room section context │ venture stage │ gaps │ context window
// Reads JSON from stdin (Claude Code statusline API)

'use strict';

const fs = require('fs');
const path = require('path');
const visual = require('../lib/core/visual-ops.cjs');

// Phase 88.1-04: statusline MINTO segment helpers. LOCAL-only per Canon
// Part 8. Lazy-required inside the resolver so a missing module (unlikely
// in a properly-installed plugin) leaves the pre-88 statusline unchanged.
let statuslineCache = null;
let folderMemory = null;
try {
  statuslineCache = require('../lib/core/statusline-cache.cjs');
} catch (_e) { /* graceful fallback, pre-88 output */ }
try {
  folderMemory = require('../lib/core/folder-memory.cjs');
} catch (_e) { /* graceful fallback, pre-88 output */ }

// Phase 91-06: Larry dial helper (pure resolver + formatter). LOCAL-only
// per Canon Part 8. Lazy-required so a missing module on a degraded
// install leaves the pre-91 statusline byte-identical.
let navDial = null;
try {
  navDial = require('../lib/core/nav-dial.cjs');
} catch (_e) { /* graceful fallback, pre-91 output */ }

const os = require('os');
const crypto = require('crypto');

