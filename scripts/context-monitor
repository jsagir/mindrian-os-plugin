#!/usr/bin/env node
// MindrianOS Statusline - ships with the plugin
// Shows: project name │ room section context │ venture stage │ gaps │ context window
// Reads JSON from stdin (Claude Code statusline API)

'use strict';

const fs = require('fs');
const path = require('path');
const visual = require('../lib/core/visual-ops.cjs');

const os = require('os');
const crypto = require('crypto');

// Map room section name to short exploration-stage label plus thematic
// emoji. Derived from the most recently modified section so the user
// sees what area they are actively exploring at a glance. Unknown
// sections map to uppercased hyphen-stripped name with a generic marker.
// Emoji inclusion per user directive 2026-04-14 overrides the repo-wide
// no-emoji rule for the statusline surface specifically. See rule doc
// in ui-system skill for the carve-out.
const EXPLORATION_LABELS = {
  'problem-definition':     { label: 'PROBLEM',       emoji: '\u{1F3AF}' }, // target
  'solution-design':        { label: 'SOLUTION',      emoji: '\u{1F4A1}' }, // lightbulb
  'business-model':         { label: 'BUSINESSCASE',  emoji: '\u{1F4B0}' }, // money bag
  'market-analysis':        { label: 'MARKET',        emoji: '\u{1F4CA}' }, // bar chart
  'competitive-analysis':   { label: 'COMPETITION',   emoji: '\u{2694}\u{FE0F}' }, // crossed swords
  'financial-model':        { label: 'FINANCE',       emoji: '\u{1F4B5}' }, // dollar banknote
  'legal-ip':               { label: 'LEGAL',         emoji: '\u{2696}\u{FE0F}' }, // scales of justice
  'team-execution':         { label: 'TEAM',          emoji: '\u{1F465}' }, // busts in silhouette
  'team':                   { label: 'TEAM',          emoji: '\u{1F465}' },
  'assets':                 { label: 'ASSETS',        emoji: '\u{1F3A8}' }, // artist palette
  'exports':                { label: 'EXPORTS',       emoji: '\u{1F4E4}' }, // outbox tray
  'meetings':               { label: 'MEETINGS',      emoji: '\u{1F5E3}\u{FE0F}' }, // speaking head
  'opportunity-bank':       { label: 'OPPORTUNITIES', emoji: '\u{1F381}' }, // wrapped gift
  'funding':                { label: 'FUNDING',       emoji: '\u{1F48E}' }  // gem stone
};

/**
 * Detect whether the Brain MCP is configured for this user. Returns
 * 'connected', 'disconnected', or 'unknown'. The detection is a proxy,
 * not a live health check: we look for the MINDRIAN_BRAIN_KEY env var
 * (which the plugin's brain-connector skill expects) and optionally for
 * a brain health bridge file if it exists. A real liveness check would
 * require an MCP round-trip, which the statusline cannot do synchronously.
 * @returns {'connected'|'disconnected'|'unknown'}
 */
function detectBrainStatus() {
  try {
    if (process.env.MINDRIAN_BRAIN_KEY && process.env.MINDRIAN_BRAIN_KEY.length > 0) {
      const health = path.join(os.homedir(), '.mindrian', 'bridge', 'brain-health.json');
      if (fs.existsSync(health)) {
        try {
          const h = JSON.parse(fs.readFileSync(health, 'utf8'));
          if (h && h.status === 'ok') return 'connected';
          if (h && h.status === 'error') return 'disconnected';
        } catch (e) {}
      }
      return 'connected';
    }
  } catch (e) {}
  return 'disconnected';
}

/**
 * Read the current MindrianOS plugin version from .claude-plugin/plugin.json.
 * Tries MINDRIAN_OS_ROOT env var first (set by settings.json), then falls
 * back to the script's parent directory. Returns empty string on any failure.
 * @returns {string} Version string like "1.10.4" or empty string
 */
function readPluginVersion() {
  // Prefer __dirname-relative path (the plugin.json that ships with
  // whichever copy of the script is actually running). Fall back to
  // MINDRIAN_OS_ROOT env var only if the dirname path does not resolve.
  // This matters in dev: the dev workspace may be ahead of the installed
  // plugin cache that the env var points at.
  const candidates = [
    path.resolve(__dirname, '..'),
    process.env.MINDRIAN_OS_ROOT
  ].filter(Boolean);
  for (const root of candidates) {
    try {
      const pluginJson = path.join(root, '.claude-plugin', 'plugin.json');
      if (fs.existsSync(pluginJson)) {
        const data = JSON.parse(fs.readFileSync(pluginJson, 'utf8'));
        if (data && data.version) return data.version;
      }
    } catch (e) {}
  }
  return '';
}

/**
 * Build a high-attention flashing UPDATE banner with per-letter rainbow
 * coloring, bold, ANSI blink, and a dark background highlight. Used when
 * the update-check bridge file reports UPDATE_AVAILABLE. Terminals that
 * ignore blink still render the per-letter bold rainbow on a highlighted
 * background, which is visually distinctive on its own.
 * @returns {string} ANSI-wrapped UPDATE banner
 */
function flashingUpdate() {
  const colors = [
    '\x1b[38;2;255;80;80m',
    '\x1b[38;2;255;160;60m',
    '\x1b[38;2;255;230;80m',
    '\x1b[38;2;80;255;120m',
    '\x1b[38;2;80;200;255m',
    '\x1b[38;2;200;120;255m'
  ];
  const letters = 'UPDATE'.split('');
  const blink = '\x1b[5m';
  const bold = '\x1b[1m';
  const bg = '\x1b[48;2;20;20;40m';
  const reset = '\x1b[0m';
  let out = `${bg} `;
  for (let i = 0; i < letters.length; i++) {
    out += `${blink}${bold}${bg}${colors[i % colors.length]}${letters[i]}`;
  }
  out += `${bg} ${reset}`;
  return out;
}

/**
 * Detect the active GSD workflow phase from .planning/ state.
 * Prefers an explicit current-phase marker; falls back to the newest phase
 * directory under .planning/phases/.
 * @param {string} dir - Workspace current directory
 * @returns {string} Phase label like "Phase 81" or empty string
 */
function detectActiveWorkflow(dir) {
  try {
    const statePath = path.join(dir, '.planning', 'STATE.md');
    if (fs.existsSync(statePath)) {
      const content = fs.readFileSync(statePath, 'utf8');
      const phaseMatch = content.match(/current[_\s-]*phase[:\s]+(\d+(?:\.\d+)?)/i) ||
                         content.match(/active[_\s-]*phase[:\s]+(\d+(?:\.\d+)?)/i);
      if (phaseMatch) return 'Phase ' + phaseMatch[1];
    }
    const phasesDir = path.join(dir, '.planning', 'phases');
    if (fs.existsSync(phasesDir)) {
      // Pick the phase directory with the most recently touched content.
      // "Newest mtime" is a better proxy for "active phase" than "highest
      // number" because scaffolded-but-unexecuted future phases can leapfrog
      // the phase you are actually working on.
      const phases = fs.readdirSync(phasesDir, { withFileTypes: true })
        .filter(d => d.isDirectory() && /^\d+/.test(d.name))
        .map(d => {
          const p = path.join(phasesDir, d.name);
          let newest = 0;
          try {
            const entries = fs.readdirSync(p);
            for (const e of entries) {
              try {
                const st = fs.statSync(path.join(p, e));
                if (st.mtimeMs > newest) newest = st.mtimeMs;
              } catch (_) {}
            }
            if (newest === 0) newest = fs.statSync(p).mtimeMs;
          } catch (_) {
            newest = 0;
          }
          return {
            name: d.name,
            num: parseFloat(d.name.match(/^(\d+(?:\.\d+)?)/)[1]),
            mtime: newest
          };
        })
        .sort((a, b) => b.mtime - a.mtime);
      if (phases.length > 0) {
        return 'Phase ' + phases[0].num;
      }
    }
  } catch (e) {}
  return '';
}

/**
 * Get per-room bridge file path at ~/.mindrian/bridge/{room-hash}.json
 * @param {string} [roomDir] - Room directory path for hashing
 * @returns {string} Bridge file path
 */
function getBridgeFile(roomDir) {
  const bridgeDir = path.join(os.homedir(), '.mindrian', 'bridge');
  if (!fs.existsSync(bridgeDir)) fs.mkdirSync(bridgeDir, { recursive: true });
  if (!roomDir) return path.join(bridgeDir, 'default.json');
  const hash = crypto.createHash('md5').update(roomDir).digest('hex').slice(0, 8);
  return path.join(bridgeDir, hash + '.json');
}

let input = '';
const timeout = setTimeout(() => process.exit(0), 3000);
process.stdin.setEncoding('utf8');
process.stdin.on('data', chunk => input += chunk);
process.stdin.on('end', () => {
  clearTimeout(timeout);
  try {
    const data = JSON.parse(input);
    const model = data.model?.display_name || 'Claude';
    const dir = data.workspace?.current_dir || process.cwd();
    const remaining = data.context_window?.remaining_percentage;
    const usedPct = data.context_window?.used_percentage;

    // Write bridge file for hooks/skills (per-room isolation)
    // Uses dir (workspace) as hash source since roomDir isn't resolved yet
    try {
      const bridgeFile = getBridgeFile(dir);
      const bridge = JSON.stringify({
        model_id: data.model?.id || 'unknown',
        model_name: model,
        ctx_pct: usedPct || 0,
        ctx_remaining: remaining || 100,
        ctx_size: data.context_window?.context_window_size || 200000,
        timestamp: Math.floor(Date.now() / 1000)
      });
      fs.writeFileSync(bridgeFile + '.tmp', bridge);
      fs.renameSync(bridgeFile + '.tmp', bridgeFile);
    } catch (e) {}

    // --- Context window bar ---
    const AUTO_COMPACT_BUFFER = 16.5;
    let ctx = '';
    if (remaining != null) {
      const usableRemaining = Math.max(0, ((remaining - AUTO_COMPACT_BUFFER) / (100 - AUTO_COMPACT_BUFFER)) * 100);
      const used = Math.max(0, Math.min(100, Math.round(100 - usableRemaining)));
      const filled = Math.floor(used / 10);
      const bar = '\u2588'.repeat(filled) + '\u2591'.repeat(10 - filled);

      if (used < 50) {
        ctx = ` ${visual.ANSI.green}${bar} ${used}%${visual.ANSI.reset}`;
      } else if (used < 65) {
        ctx = ` ${visual.ANSI.yellow}${bar} ${used}%${visual.ANSI.reset}`;
      } else if (used < 80) {
        ctx = ` ${visual.ANSI.sienna}${bar} ${used}%${visual.ANSI.reset}`;
      } else {
        ctx = ` \x1b[5;31m\u{1F480} ${bar} ${used}%\x1b[0m`;
      }
    }

    // --- Room context ---
    let roomInfo = '';
    // Resolve room path: try registry first, fall back to room/
    let roomDir = '';
    const registryPath = path.join(dir, '.rooms', 'registry.json');
    if (fs.existsSync(registryPath)) {
      try {
        const reg = JSON.parse(fs.readFileSync(registryPath, 'utf8'));
        if (reg.active && reg.rooms[reg.active]) {
          const resolved = path.resolve(dir, reg.rooms[reg.active].path);
          if (fs.existsSync(resolved)) roomDir = resolved;
        }
      } catch (e) {}
    }
    if (!roomDir) {
      const legacy = path.join(dir, 'room');
      if (fs.existsSync(legacy)) roomDir = legacy;
    }
    // Resolve the active room display name from the registry if present,
    // otherwise fall back to STATE.md project_name or directory basename.
    let roomName = '';
    if (fs.existsSync(registryPath)) {
      try {
        const reg = JSON.parse(fs.readFileSync(registryPath, 'utf8'));
        if (reg.active && reg.rooms[reg.active]) {
          roomName = reg.rooms[reg.active].name || reg.active;
        }
      } catch (e) {}
    }

    if (roomDir) {
      try {
        if (!roomName) roomName = path.basename(dir);
        const roomState = path.join(roomDir, 'STATE.md');

        if (fs.existsSync(roomState)) {
          const content = fs.readFileSync(roomState, 'utf8');
          const nameMatch = content.match(/project_name:\s*(.+)/);
          if (nameMatch) roomName = nameMatch[1].trim();
        }

        // Walk sections only to find the most recently modified one
        // (the current exploration focus). Everything else about
        // sections (counts, gaps, phase, stage, exploration label)
        // was removed from the statusline per user spec 2026-04-14.
        const sections = fs.readdirSync(roomDir, { withFileTypes: true })
          .filter(d => d.isDirectory() && !d.name.startsWith('.'));

        let currentSection = '';
        let latestMtime = 0;
        for (const s of sections) {
          const sPath = path.join(roomDir, s.name);
          try {
            const files = fs.readdirSync(sPath).filter(f => f.endsWith('.md'));
            for (const f of files) {
              const stat = fs.statSync(path.join(sPath, f));
              if (stat.mtimeMs > latestMtime) {
                latestMtime = stat.mtimeMs;
                currentSection = s.name;
              }
            }
          } catch (e) {}
        }

        // Build room status parts (De Stijl visual identity)
        // Per user spec 2026-04-14: the room marker carries the ACTIVE
        // ROOM NAME (not a static LARRY label), followed by the current
        // section as a status breadcrumb. No venture stage, no section
        // count, no gap count, no phase indicator, no exploration label.
        const parts = [];

        // Room name with house emoji prefix. Gold bold for brand identity.
        const gold = visual.ANSI.gold || visual.ANSI.amber || '\x1b[38;2;245;194;66m';
        let roomCrumb = `\u{1F3E0} ${gold}${visual.ANSI.bold}${roomName}${visual.ANSI.reset}`;
        if (currentSection) {
          // Section breadcrumb with folder emoji. Muted arrow separator.
          roomCrumb += ` ${visual.ANSI.muted}\u25B6${visual.ANSI.reset} \u{1F4C2} ${visual.ANSI.cyan}${currentSection}${visual.ANSI.reset}`;
        }
        parts.push(roomCrumb);

        // Exploration stage label with thematic emoji per stage
        // (target, lightbulb, money bag, bar chart, etc). Derived from
        // currentSection via EXPLORATION_LABELS map. Unknown sections
        // fall back to a generic magnifying-glass emoji plus uppercase
        // section name.
        if (currentSection) {
          const stageEntry = EXPLORATION_LABELS[currentSection];
          const emoji = stageEntry ? stageEntry.emoji : '\u{1F50D}';
          const label = stageEntry ? stageEntry.label : currentSection.replace(/-/g, ' ').toUpperCase();
          parts.push(`${emoji} ${visual.ANSI.yellow}${label}${visual.ANSI.reset}`);
        }

        // MindrianOS plugin brand (brain emoji) + current version +
        // persistent /mos:update hint. The green circle plus the
        // literal command is a zero-runtime-cost nudge that works on
        // airgapped machines, independent of any update-detection
        // pipeline. Honest about what it is: a reminder, not a signal.
        const pluginVersion = readPluginVersion();
        const updateHint = `\u{1F504} ${visual.ANSI.dim}/mos:update${visual.ANSI.reset}`;
        let pluginPart = `\u{1F9E0} ${visual.ANSI.cyan}MindrianOS${visual.ANSI.reset}`;
        if (pluginVersion) {
          pluginPart += ` ${visual.ANSI.dim}v${pluginVersion}${visual.ANSI.reset}`;
        }
        pluginPart += ` ${updateHint}`;
        parts.push(pluginPart);

        // Brain connection status. Green DNA if MINDRIAN_BRAIN_KEY is
        // set (with optional health-bridge confirmation). Red DNA if
        // not configured. This is a proxy, not a live health check -
        // the statusline cannot do an MCP round-trip synchronously.
        const brainStatus = detectBrainStatus();
        if (brainStatus === 'connected') {
          parts.push(`\u{1F9EC} ${visual.ANSI.green}BRAIN${visual.ANSI.reset}`);
        } else if (brainStatus === 'disconnected') {
          parts.push(`\u{1F9EC} ${visual.ANSI.red}BRAIN${visual.ANSI.reset}`);
        }

        roomInfo = parts.join(` ${visual.ANSI.muted}${visual.SYMBOLS.box.v}${visual.ANSI.reset} `);
      } catch (e) {}
    } else {
      // No room resolved. Still show the plugin version so users outside
      // any room know which MindrianOS is running.
      const pluginVersion = readPluginVersion();
      if (pluginVersion) {
        roomInfo = `${visual.ANSI.cyan}${visual.SYMBOLS.brand} MindrianOS${visual.ANSI.reset} ${visual.ANSI.dim}v${pluginVersion}${visual.ANSI.reset}`;
      }
    }

    // --- Output ---
    // The update nudge is baked into the plugin version element now.
    // No separate update-check read; no dependency on a bridge file
    // that nothing writes.
    if (roomInfo) {
      process.stdout.write(`${roomInfo} ${visual.ANSI.muted}${visual.SYMBOLS.box.v}${visual.ANSI.reset} ${visual.ANSI.dim}${model}${visual.ANSI.reset}${ctx}`);
    } else {
      const dirname = path.basename(dir);
      process.stdout.write(`${visual.ANSI.dim}${model}${visual.ANSI.reset} ${visual.ANSI.muted}${visual.SYMBOLS.box.v}${visual.ANSI.reset} ${visual.ANSI.dim}${dirname}${visual.ANSI.reset}${ctx}`);
    }
  } catch (e) {
    // Silent fail
  }
});
