#!/usr/bin/env bash
set -euo pipefail
# post-write -- PostToolUse handler for Write, Edit, and MultiEdit
# Routes to classify-insight for room file classification
# Routes to file-asset for binary file detection
# Phase 88-04: also fires the per-section freshness triple when a write
# lands inside a Data Room section (detected via .room-root sentinel):
#   1. Enqueue MINTO regen via minto-debouncer (synchronous, fast)
#   2. Recompile ROOM.md references (backgrounded)
#   3. Stamp last_artifact_write_seen_at on MINTO.md frontmatter (backgrounded)
# System files (ROOM.md/STATE.md/MINTO.md) stamp only. Non-.md files skip
# enqueue + recompile. Stamp and recompile are spawned BACKGROUNDED so the
# user-visible hook return is not serialized on the write-lock.
#
# Called by run-hook.cmd when PostToolUse fires after Write/Edit/MultiEdit.
# Claude Code passes hook data as JSON on stdin (PostToolUse schema):
#   { "tool_name": "Write"|"Edit"|"MultiEdit", "tool_input": { "file_path": "..." }, ... }

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Phase 88-04: detect whether FILE_PATH lives inside a Data Room section by
# walking up for the .room-root sentinel. On hit, echoes "<roomDir>|<section>"
# to stdout and returns 0. On miss, returns 1. Section name is the first
# directory under the room root. Cap hops at 12 to avoid pathological loops.
detect_room_section() {
  local file_path="$1"
  local dir
  dir=$(dirname "$file_path")
  local hops=0
  while [ "$dir" != "/" ] && [ "$dir" != "." ] && [ "$hops" -lt 12 ]; do
    # Phase 400.3 plan 02 (review minor design 8): stop at a drive root
    # (X: or X:/) and at a UNC share root (//host/share).
    if [[ $dir =~ $DRIVE_ROOT_RE ]] || [[ $dir =~ $UNC_SHARE_ROOT_RE ]]; then break; fi
    if [ -e "$dir/.room-root" ]; then
      # dir is the room root. section = first path component under dir.
      # Fix round (400.3): the room prefix is quoted, so a folder name with
      # glob characters (for example shell[x]) is matched literally.
      local rel="${file_path#"$dir"/}"
      local section="${rel%%/*}"
      # Guard: the file must actually be under a section, not directly
      # in the room root.
      if [ -n "$section" ] && [ "$section" != "$rel" ]; then
        printf '%s|%s\n' "$dir" "$section"
        return 0
      fi
      return 1
    fi
    local parent
    parent=$(dirname "$dir")
    [ "$parent" = "$dir" ] && break
    dir="$parent"
    hops=$((hops + 1))
  done
  return 1
}

# ---------------------------------------------------------------------------
# Phase 95-02: bash post-write envelope hygiene + cascade side-channel.
#
# Cascade payload used to live at JSON ROOT alongside `systemMessage`
# (cascade_status, classification, git_commit, graph_index,
# proactive_intelligence). Claude Code 2.x's PostToolUse schema sets
# `additionalProperties: false`, which rejects every unknown root key.
# Result: (a) "Hook JSON output validation failed" tripped on every
# cascade, and (b) the room-proactive skill received nothing because
# the envelope was silently dropped or partially surfaced.
#
# Phase 95-02 fix:
# 1. Stdout becomes ONE JSON object with `hookSpecificOutput` only.
#    additionalContext carries the existing tight one-line systemMessage.
# 2. The full cascade payload moves to <roomDir>/.mindrian/last-cascade.json,
#    written atomically (mktemp inside SIDE_DIR + mv -f for POSIX-atomic
#    rename(2) on the same filesystem). LOCAL only - never network surface
#    per Canon Part 8.
# 3. The skills/room-proactive/SKILL.md trigger contract (Plan 95-03) reads
#    the side-channel file when it sees one of the two recognized
#    additionalContext prefixes:
#       ^post-write: cascade complete
#       ^queued MINTO regen
#    Phase 400.3 plan 02 (D-07): the 2 index-only advisories
#    ("post-write: indexed <file> (index only)" and
#    "post-write: index failed for <file> (index only)") are honest status
#    lines, not room-proactive triggers.
#    Phase 400.3 plan 03 (OR-6, D-07): a partial cascade in a section keeps the
#    'queued MINTO regen' prefix on purpose (skills/room-proactive/SKILL.md
#    still reads last-cascade.json) and adds '; cascade partial: <steps>
#    failed'; outside a section, "post-write: cascade partial for <file>
#    (<steps> failed)" is an honest status line, not a room-proactive trigger.
# ---------------------------------------------------------------------------

# Phase 400.3 plan 03 (OR-6, D-07): the failed step names of a partial cascade,
# graph-index first (with its typed reason when it has one), then the other
# failed keys in output order, at most 3 names, then ' and <n> more'.
# Soft-fails to the word 'steps'. Never fails.
cascade_partial_steps_of() {
  local out="$1"
  local names
  names=$(printf '%s' "$out" | jq -r '
    def stepname($k): {"graphIndex":"graph-index","classification":"classify","gitCommit":"git-commit",
      "artifactId":"artifact-id","deriveEnqueue":"derive-enqueue","hsiBridge":"hsi-bridge",
      "computeState":"compute-state","buildGraph":"build-graph","proactiveIntelligence":"analyze-room",
      "opportunityExtraction":"opportunity-extraction","binaryAsset":"file-asset"}[$k] // $k;
    . as $o
    | [keys_unsorted[] | select(($o[.] | type) == "object" and $o[.].status == "error")] as $f
    | ((if ($f | index("graphIndex")) != null then ["graphIndex"] else [] end) + ($f - ["graphIndex"])) as $ord
    | [$ord[] | if . == "graphIndex" and (($o.graphIndex.reason | type) == "string")
                then "graph-index (" + $o.graphIndex.reason + ")" else stepname(.) end] as $n
    | if ($n | length) == 0 then "steps"
      elif ($n | length) <= 3 then ($n | join(", "))
      else ($n[0:3] | join(", ")) + " and " + (($n | length) - 3 | tostring) + " more" end' 2>/dev/null) || names="steps"
  [ -z "$names" ] && names="steps"
  printf '%s' "$names"
}

# Emit a Claude Code 2.x compliant PostToolUse advisory envelope.
# Empty input -> silent (zero bytes). Non-empty -> single JSON line.
emit_post_tool_use_envelope() {
  local msg="$1"
  if [ -z "$msg" ]; then return 0; fi
  jq -nc --arg m "$msg" '{
    hookSpecificOutput: {
      hookEventName: "PostToolUse",
      additionalContext: $m
    }
  }'
}

# Phase 386-15 (B7): the real status of a cascade run, read from its output.
#   failed   - the output has an error key, or it is not JSON at all
#   skipped  - the cascade returned skipped true (path outside a room, etc.)
#   complete - the cascade ran
#   indexed / index_failed - Phase 400.3 plan 02 (D-07): an index-only run
#              (mode "index-only") whose graph index did or did not land
#   partial  - Phase 400.3 plan 03 (OR-6, D-07): a full cascade that ran with
#              1 or more failed steps (a step entry with status "error")
#   pending  - written by the caller before the node call (D-11), never
#              returned here
# Prints one word. Never fails.
cascade_status_of() {
  local out="$1"
  local word
  word=$(printf '%s' "$out" | jq -r 'if type != "object" then "failed"
    elif has("error") then "failed"
    elif .skipped == true then "skipped"
    elif .mode == "index-only" then (if ((.graphIndex.status // "") == "ok") then "indexed" else "index_failed" end)
    elif ([.[] | select(type == "object" and .status == "error")] | length) > 0 then "partial"
    else "complete" end' 2>/dev/null) || word="failed"
  case "$word" in
    failed|skipped|complete|indexed|index_failed|partial) printf '%s' "$word" ;;
    *) printf 'failed' ;;
  esac
}

# Write cascade payload atomically to <roomDir>/.mindrian/last-cascade.json.
# Soft-fail at every step: a permission error, missing jq, or torn temp file
# MUST NOT break the post-write hook.
write_cascade_side_channel() {
  local room_dir="$1"
  local file_path="$2"
  local section="$3"
  local cascade_output="$4"
  local session_id="$5"
  local cascade_status="${6:-complete}"
  # Phase 400.3 plan 02 (D-11): optional pending id. Only the pending record
  # carries the key pending_id; every final record keeps the 8 keys of before.
  local pending_id="${7:-}"

  [ -z "$room_dir" ] && return 0
  [ -z "$cascade_output" ] && return 0

  # Phase 386-15 (B7): output that is not JSON must still overwrite the old
  # record (as failed), or a stale record from an earlier write stays in place.
  if ! printf '%s' "$cascade_output" | jq -e 'type == "object"' >/dev/null 2>&1; then
    cascade_output='{"error":"cascade output not parseable"}'
  fi

  local side_dir="$room_dir/.mindrian"
  mkdir -p "$side_dir" 2>/dev/null || return 0

  local payload
  payload=$(jq -nc \
    --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg fp "$file_path" \
    --arg sec "$section" \
    --arg sid "$session_id" \
    --arg st "$cascade_status" \
    --arg pid "$pending_id" \
    --argjson cascade "$cascade_output" \
    '{
      timestamp: $ts,
      file_path: $fp,
      section: $sec,
      session_id: (if $sid == "" then null else $sid end),
      cascade_status: $st,
      classification: ($cascade.classification // null),
      git_commit: ($cascade.gitCommit // null),
      graph_index: ($cascade.graphIndex // null),
      proactive_intelligence: ($cascade.proactiveIntelligence // null)
    } + (if $pid == "" then {} else {pending_id: $pid} end)' 2>/dev/null) || return 0

  # Atomic write via mktemp inside SIDE_DIR (same-filesystem invariant) +
  # mv -f. POSIX-portable form: no `-p` flag (BSD/macOS divergence; the
  # template path itself dictates the directory).
  local tmp
  tmp=$(mktemp "$side_dir/.last-cascade.json.XXXXXX" 2>/dev/null) || return 0
  printf '%s\n' "$payload" > "$tmp" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 0; }
  mv -f "$tmp" "$side_dir/last-cascade.json" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 0; }
}

# Read file path from stdin JSON (Claude Code hook API),
# fall back to $1 or TOOL_INPUT_PATH for backward compatibility
# Phase 237-06 (REACH-03): SESSION_ID is read alongside FILE_PATH from the
# SAME hook stdin payload -- session_id is a documented COMMON input field
# on every hook event including PostToolUse. Manual/TTY invocation has no
# hook stdin, so SESSION_ID stays empty there (the degrade path).
SESSION_ID=""
if [ -t 0 ]; then
  # stdin is a terminal (manual invocation) -- use args
  FILE_PATH="${1:-${TOOL_INPUT_PATH:-}}"
else
  # stdin has data -- parse JSON from Claude Code hook
  HOOK_INPUT=$(cat)
  FILE_PATH=$(echo "$HOOK_INPUT" | jq -r '.tool_input.file_path // empty' 2>/dev/null || true)
  # Fallback: try tool_response.filePath
  if [[ -z "$FILE_PATH" ]]; then
    FILE_PATH=$(echo "$HOOK_INPUT" | jq -r '.tool_response.filePath // empty' 2>/dev/null || true)
  fi
  # Final fallback: positional arg or env var
  if [[ -z "$FILE_PATH" ]]; then
    FILE_PATH="${1:-${TOOL_INPUT_PATH:-}}"
  fi
  SESSION_ID=$(echo "$HOOK_INPUT" | jq -r '.session_id // empty' 2>/dev/null || true)
fi

if [[ -z "$FILE_PATH" ]]; then
  exit 0
fi

# ---------------------------------------------------------------------------
# Phase 400.3 plan 02 (D-01, D-03 amended, D-06, D-10, D-11, review B-1 and
# M-6, revision W1): one walk path for every walk below.
#
# A native Windows hook gets a backslash path (C:\Users\u\MindrianRooms\x\a.md
# or \\host\share\...). bash dirname of such a string is '.', so no walk ever
# started. WALK_PATH is FILE_PATH with every backslash turned into '/', only
# for the drive form and the UNC form; a POSIX path never changes. Bash
# builtins only (D-06: no new child). The Git Bash path converter is not used: its /c/... form
# reads as a folder on the current drive in native Windows node.
#
# Behaviour change on Windows (review minor design 12): stamp, MINTO enqueue
# and recompile below now also fire for a backslash path.
#
# Node stays the only room resolver (review B-1): FILE_PATH goes raw to the
# cascade, and the final side-channel record goes to the roomDir node reports.
# The Linux runs prove the walks on Linux path-string proxies only; native
# Windows is UNMEASURED.
# ---------------------------------------------------------------------------
DRIVE_FORM_RE='^[A-Za-z]:\\'
UNC_FORM_RE='^\\\\'
DRIVE_ROOT_RE='^[A-Za-z]:/?$'
UNC_SHARE_ROOT_RE='^//[^/]+/[^/]+/?$'
WALK_PATH="$FILE_PATH"
if [[ "$FILE_PATH" == *\\* ]]; then
  if [[ $FILE_PATH =~ $DRIVE_FORM_RE ]] || [[ $FILE_PATH =~ $UNC_FORM_RE ]]; then
    WALK_PATH="${FILE_PATH//\\//}"
  fi
fi
# Fix round (400.3, coordinator item 1): every advisory and the system-file
# test below name the file by the WALK_PATH basename, so a backslash path
# gives 'a.md', not the whole string.
FILE_BASE="${WALK_PATH##*/}"
[ -z "$FILE_BASE" ] && FILE_BASE="file"

# Phase 400.3 plan 02 (D-11) and fix round item 2: the pending record. It is
# written before the foreground debouncer below (when the room is already
# known) and again before the node call when the cascade room differs, so a
# host kill at any point after the room is known leaves 'pending', never a
# stale 'indexed'. Only the record that still holds this run's pending_id is
# ever removed.
PENDING_ID="$$-$RANDOM"
EARLY_PENDING_DIR=""
drop_own_pending() {
  local dir="$1"
  [ -z "$dir" ] && return 0
  local left
  left=$(jq -r '.pending_id // empty' "$dir/.mindrian/last-cascade.json" 2>/dev/null) || left=""
  if [ -n "$left" ] && [ "$left" = "$PENDING_ID" ]; then
    rm -f "$dir/.mindrian/last-cascade.json" 2>/dev/null || true
  fi
  return 0
}

# ---------------------------------------------------------------------------
# Phase 88-04: triple-fire on room section writes.
#
# Fires BEFORE the existing cascade block so the freshness wires land even
# when the legacy cascade path is skipped (e.g. fixture rooms that do not
# carry STATE.md at the room root). Detection uses the .room-root sentinel
# from Phase 87-01a, which is distinct from (and complementary to) the
# STATE.md walk used below for the cascade.
#
# Latency contract (88-04):
#   - Target: < 300ms user-visible foreground under uncontended conditions.
#   - Hard ceiling: 3000ms hook timeout (hooks.json).
#   - Under 20-writer Cowork contention: stamp + recompile serialize on the
#     room-level write-lock, but both are spawned BACKGROUNDED so the
#     user-visible hook return is NOT gated on them. Only the debouncer
#     enqueue runs in the foreground; it is a single tiny JSON write that
#     completes in single-digit ms.
#
# Safety: every call is wrapped in `|| true` so a broken dependency cannot
# break the hook. The final `exit 0` at the bottom of this script is the
# soft-fail guarantee.
# ---------------------------------------------------------------------------
if ROOM_SECTION_INFO=$(detect_room_section "$WALK_PATH" 2>/dev/null); then
  ROOM_DIR="${ROOM_SECTION_INFO%|*}"
  SECTION="${ROOM_SECTION_INFO##*|}"
  BASENAME="$FILE_BASE"

  # Fix round item 2 (D-11): the pending record goes in before the foreground
  # debouncer, which can wait about 11-14 s on a held write.lock. Only a room
  # that can reach the cascade (STATE.md or an existing room.db) gets it.
  if [ -f "$ROOM_DIR/STATE.md" ] || { [ -f "$ROOM_DIR/.mindrian/room.db" ] && [ -s "$ROOM_DIR/.mindrian/room.db" ]; }; then
    write_cascade_side_channel "$ROOM_DIR" "$FILE_PATH" "${SECTION:-unknown}" '{}' "$SESSION_ID" pending "$PENDING_ID"
    EARLY_PENDING_DIR="$ROOM_DIR"
  fi

  # Stamp ALWAYS fires (even for system-file writes -- section mtime
  # changed). BACKGROUNDED so it never serializes on the write-lock during
  # the user-visible hook return.
  ( node "${SCRIPT_DIR}/stamp-artifact-write.cjs" "$ROOM_DIR/$SECTION" >/dev/null 2>&1 || true ) &

  # Enqueue regen + recompile ROOM.md references only for non-system .md
  # files. ROOM.md/STATE.md/MINTO.md are the TARGETS of reasoning, not
  # artifact signals -- they must not trigger regen or they create
  # infinite loops with the regen worker.
  case "$BASENAME" in
    ROOM.md|STATE.md|MINTO.md)
      : # system file: stamp only, skip enqueue + recompile
      ;;
    *.md)
      # Debouncer CLI: node <script>/minto-debouncer.cjs enqueue <roomDir> <section> <reason>
      # Synchronous (fast JSON write); soft-fail via || true.
      DEBOUNCER_SCRIPT="${SCRIPT_DIR}/minto-debouncer.cjs"
      node "$DEBOUNCER_SCRIPT" enqueue "$ROOM_DIR" "$SECTION" "post-write:$BASENAME" >/dev/null 2>&1 || true
      # Recompile ROOM.md references BACKGROUNDED. Do not block the hook
      # return on the recompile write-lock wait.
      ( node "${SCRIPT_DIR}/recompile-room-references.cjs" "$ROOM_DIR/$SECTION" >/dev/null 2>&1 || true ) &
      ;;
    *)
      : # non-.md files (.txt, .pdf, .png, ...): skip enqueue + recompile
      ;;
  esac
fi

# Resolve active room for guard check
ACTIVE_ROOM=$("${SCRIPT_DIR}/resolve-room" "$PWD" 2>/dev/null) || ACTIVE_ROOM=""

# Track artifact creation if in room/ or rooms/
if [[ "$FILE_PATH" == */room/* ]] || [[ "$FILE_PATH" == */rooms/* ]]; then
  # Active room guard: skip processing for non-active rooms
  if [ -n "$ACTIVE_ROOM" ]; then
    case "$FILE_PATH" in
      "${ACTIVE_ROOM}"/*) ;; # File is in active room -- proceed
      *) drop_own_pending "$EARLY_PENDING_DIR"; exit 0 ;; # File is in a different room -- skip silently
    esac
  fi
  # Extract section name from path (parent directory of the file)
  section=$(dirname "$FILE_PATH" | xargs basename || true)
  if [ -n "$section" ]; then
    bash "${SCRIPT_DIR}/track-analytics" artifact "$section" 2>/dev/null &
  fi
fi

# Resolve plugin root and room directory for downstream steps
PLUGIN_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
room_dir=""

# Walk up from WALK_PATH looking for STATE.md to find room root
# Runs for ALL file types (binary and markdown) so room_dir is available
# Phase 400.3 plan 02: the walk starts from WALK_PATH (same string as
# FILE_PATH on POSIX), keeps STATE.md as its only marker and no hop cap, and
# also stops at a drive root, a UNC share root, and when dirname returns the
# folder itself (review minor design 8).
check_dir=$(dirname "$WALK_PATH")
while [ "$check_dir" != "/" ] && [ "$check_dir" != "." ]; do
  if [[ $check_dir =~ $DRIVE_ROOT_RE ]] || [[ $check_dir =~ $UNC_SHARE_ROOT_RE ]]; then break; fi
  if [ -f "$check_dir/STATE.md" ]; then
    room_dir="$check_dir"
    break
  fi
  next_dir=$(dirname "$check_dir")
  [ "$next_dir" = "$check_dir" ] && break
  check_dir="$next_dir"
done

# Phase 400.3 plan 02 (revision W1, D-10): the .room-root fallback. A new
# shell room (lib/core/room-auto-create.cjs) holds .room-root and room.db
# before it holds STATE.md, so the walk above finds nothing. Only then, and
# only when detect_room_section found a room folder that already holds
# .mindrian/room.db, the room is indexed with graph-index only. No third walk
# (review M-6): ROOM_DIR comes from detect_room_section above. No hook creates
# room.db (D-10). A STATE.md room keeps the same node command line as before.
CASCADE_INDEX_ONLY=""
# plan 400.3-06a: a 0-byte room.db is no room.db, the bash twin of roomDbPresent in lib/core/room-root.cjs.
if [ -z "$room_dir" ] && [ -n "${ROOM_DIR:-}" ] && { [ -f "${ROOM_DIR}/.mindrian/room.db" ] && [ -s "${ROOM_DIR}/.mindrian/room.db" ]; }; then
  room_dir="$ROOM_DIR"
  CASCADE_INDEX_ONLY=1
fi
# No cascade room: this run's early pending record must not stay behind.
if [ -z "$room_dir" ]; then
  drop_own_pending "$EARLY_PENDING_DIR"
fi

# -- Delegate intelligence cascade to shared module (works on all surfaces) --
# The shared module (lib/core/intelligence-cascade.cjs) handles:
#   - Binary file detection and routing to file-asset
#   - Markdown cascade: classify-insight, graph-index, HSI, reverse salients, hsi-to-graph, presentation
# This keeps CLI hooks and MCP tools using identical intelligence logic.
if [ -n "$room_dir" ]; then
  # Phase 400.3 plan 02 (D-11): a pending record first, so a host kill
  # during the node call leaves 'pending', never a stale 'indexed'. Skipped
  # when the early record above already went to this room.
  if [ "$room_dir" != "$EARLY_PENDING_DIR" ]; then
    write_cascade_side_channel "$room_dir" "$FILE_PATH" "${SECTION:-unknown}" '{}' "$SESSION_ID" pending "$PENDING_ID"
  fi

  # Run cascade in foreground so we can capture and report status
  CASCADE_OUTPUT=$(node "${PLUGIN_ROOT}/scripts/mindrian-tools.cjs" cascade "$room_dir" "$FILE_PATH" --raw ${CASCADE_INDEX_ONLY:+--index-only} 2>/dev/null) || CASCADE_OUTPUT='{"error":"cascade failed"}'

  # Phase 400.3 plan 02 (review B-1): node is the only room resolver. The
  # final record goes to the roomDir node reports, so the record and the
  # index are always in the same room.
  FINAL_ROOM_DIR=$(printf '%s' "$CASCADE_OUTPUT" | jq -r 'if type == "object" then (.roomDir // empty) else empty end' 2>/dev/null) || FINAL_ROOM_DIR=""
  # Fix round item 4: node on win32 reports a backslash roomDir; bash writes
  # to it, so turn every backslash into '/' first.
  FINAL_ROOM_DIR="${FINAL_ROOM_DIR//\\//}"
  [ -z "$FINAL_ROOM_DIR" ] && FINAL_ROOM_DIR="$room_dir"

  # 88.1-03: systemMessage retrofit. Derive a tight one-line status reporting
  # which section fired the regen/recompile cascade plus the triggering
  # artifact basename. LOCAL-only (Canon Part 8): never leaks file content.
  # Soft-fail: if detect_room_section did not populate SECTION/BASENAME (write
  # outside a room), fall back to a generic "cascade complete" line.
  SM_SECTION="${SECTION:-unknown}"
  SM_BASENAME="${BASENAME:-$FILE_BASE}"
  # Phase 386-15 (B7): the advisory states what happened. A skipped or failed
  # cascade is not reported as complete or as a queued regen.
  CASCADE_STATUS=$(cascade_status_of "$CASCADE_OUTPUT")
  if [ "$CASCADE_STATUS" = "skipped" ]; then
    SM_TEXT="post-write: cascade skipped for ${FILE_BASE}"
  elif [ "$CASCADE_STATUS" = "failed" ]; then
    SM_TEXT="post-write: cascade failed for ${FILE_BASE}"
  elif [ "$CASCADE_STATUS" = "indexed" ]; then
    # Phase 400.3 plan 02 (D-07): an index-only run never says cascade complete.
    SM_TEXT="post-write: indexed ${FILE_BASE} (index only)"
  elif [ "$CASCADE_STATUS" = "index_failed" ]; then
    SM_TEXT="post-write: index failed for ${FILE_BASE} (index only)"
  elif [ "$CASCADE_STATUS" = "partial" ]; then
    # Phase 400.3 plan 03 (OR-6, D-07): name the failed steps.
    PARTIAL_STEPS=$(cascade_partial_steps_of "$CASCADE_OUTPUT")
    if [ "$SM_SECTION" = "unknown" ]; then
      SM_TEXT="post-write: cascade partial for ${FILE_BASE} (${PARTIAL_STEPS} failed)"
    else
      SM_TEXT="queued MINTO regen for ${SM_SECTION}, recompiled references (${SM_BASENAME}); cascade partial: ${PARTIAL_STEPS} failed"
    fi
  elif [ "$SM_SECTION" = "unknown" ]; then
    SM_TEXT="post-write: cascade complete for ${FILE_BASE}"
  else
    SM_TEXT="queued MINTO regen for ${SM_SECTION}, recompiled references (${SM_BASENAME})"
  fi

  # 95-02: side-channel write + envelope-only stdout.
  # The full cascade payload (classification + gitCommit + graphIndex +
  # proactiveIntelligence) goes into <roomDir>/.mindrian/last-cascade.json.
  # Stdout is ONLY the schema-valid envelope advisory.
  write_cascade_side_channel "$FINAL_ROOM_DIR" "$FILE_PATH" "${SECTION:-unknown}" "$CASCADE_OUTPUT" "$SESSION_ID" "$CASCADE_STATUS"
  # Review B-1: when node indexed another room, remove this run's pending
  # record from room_dir and from the early room (only a record that still
  # holds this run's pending_id).
  [ "$FINAL_ROOM_DIR" != "$room_dir" ] && drop_own_pending "$room_dir"
  [ "$FINAL_ROOM_DIR" != "$EARLY_PENDING_DIR" ] && drop_own_pending "$EARLY_PENDING_DIR"
  :
  emit_post_tool_use_envelope "$SM_TEXT"
fi

# Phase 88-04: explicit exit 0 -- the PostToolUse hook is a soft-fail channel.
# Any failure upstream (cascade, triple-fire, stamp, debouncer, recompile)
# must NOT propagate as a non-zero exit that could surface to the user as a
# broken Write/Edit/MultiEdit tool call.
exit 0
