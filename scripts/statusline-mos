#!/usr/bin/env bash
# MindrianOS statusline resolver
# ----------------------------------
# Always execs the context-monitor script from the latest installed
# version of mos@mindrian-marketplace, regardless of which cache directory
# Claude Code has materialized. This is a self-healing wrapper so
# ~/.claude/settings.json never needs to be edited when a new MindrianOS
# version ships. The legacy ~/.claude/plugins/mindrian-os/ install path
# is intentionally NOT consulted; that path is inert and stuck at v1.10.0.
#
# Created 2026-04-14 in response to a Lawrence-class observation:
# v1.10.4 statusline redesign and v1.10.5 wiki fix shipped to the
# marketplace cache, but a fresh Claude Code session was still rendering
# the v1.10.0 legacy statusline because settings.json pointed at the
# legacy path. This wrapper makes that class of bug structurally
# impossible to hit again.

set -euo pipefail

CACHE_ROOT="${HOME}/.claude/plugins/cache/mindrian-marketplace/mos"

if [ ! -d "${CACHE_ROOT}" ]; then
  # Cache directory does not exist (mos plugin not installed via marketplace).
  # Fall back silently: emit nothing so Claude Code's default statusline renders.
  exit 0
fi

# Find the highest version directory under the cache root.
# Directory names look like "1.12.0", "1.13.0-beta.9", "1.12.5.1", etc.
# The old anchor ^[0-9]+\.[0-9]+\.[0-9]+$ rejected pre-release suffixes, so a
# box with 1.12.0 + 1.13.0-beta.9 in the cache picked 1.12.0 as "latest" and
# rendered the stale statusline from there (and exported the wrong
# MINDRIAN_OS_ROOT). Accept dotted numeric versions with an optional
# pre-release tail; sort -V orders them correctly (1.12.0 < 1.13.0-beta.9 < 1.13.0).
LATEST_VERSION="$(ls -1 "${CACHE_ROOT}" 2>/dev/null | grep -E '^[0-9]+(\.[0-9]+)+(-[A-Za-z0-9.]+)?$' | sort -V | tail -1)"

if [ -z "${LATEST_VERSION}" ]; then
  exit 0
fi

CONTEXT_MONITOR="${CACHE_ROOT}/${LATEST_VERSION}/scripts/context-monitor"

if [ ! -x "${CONTEXT_MONITOR}" ] && [ ! -f "${CONTEXT_MONITOR}" ]; then
  exit 0
fi

# Set MINDRIAN_OS_ROOT so the context-monitor's plugin-version resolution
# prefers the cache copy (matches the script that is actually running).
export MINDRIAN_OS_ROOT="${CACHE_ROOT}/${LATEST_VERSION}"

# Phase 109-02: compute active session focus and emit a 🎯 focus glyph prefix
# when getActiveFocus returns non-null. The focus_segment is best-effort: any
# error in the navigation API or sqlite handle silently degrades to an empty
# prefix (Canon Part 8 LOCAL-only by construction; statusline must never
# block or throw). The 🎯 glyph is shared with the Phase 106-02 JTBD broadcast
# per the amended fence in tests/test-context-monitor-d02-broadcast.cjs (see
# the Phase 109-02 amendment block); auto-focus rule 1 makes the two signals
# semantically correlated. The prefix prints BEFORE exec so the statusline
# composes as: <focus_segment><context-monitor stdout>.
focus_segment=""
if [ -n "${MINDRIAN_ROOM:-}" ] && [ -n "${session_id:-}" ]; then
  focus_data=$(MINDRIAN_OS_ROOT="${MINDRIAN_OS_ROOT}" \
    MINDRIAN_ROOM="${MINDRIAN_ROOM}" \
    SESSION_ID="${session_id}" \
    node -e "
      const path = require('node:path');
      try {
        const root = process.env.MINDRIAN_OS_ROOT || '';
        const room = process.env.MINDRIAN_ROOM;
        const sess = process.env.SESSION_ID;
        const { openRoomDb } = require(path.join(root, 'lib', 'core', 'room-db.cjs'));
        const focus = require(path.join(root, 'lib', 'core', 'navigation', 'focus.cjs'));
        const db = openRoomDb(room);
        const f = focus.getActiveFocus(db, sess);
        try { db.close(); } catch (_) { /* ignore */ }
        if (f) process.stdout.write(JSON.stringify(f));
      } catch (_) { /* statusline never throws */ }
    " 2>/dev/null)
  if [ -n "$focus_data" ]; then
    focus_short=$(printf '%s' "$focus_data" | node -e "
      let buf = '';
      process.stdin.on('data', (d) => { buf += d; });
      process.stdin.on('end', () => {
        try {
          const f = JSON.parse(buf);
          const id = (f.focusNodeId || '').split(':').slice(1).join(':') || (f.focusNodeId || '');
          const trimmed = id.length > 24 ? id.slice(0, 21) + '...' : id;
          process.stdout.write((f.focusType || 'focus') + ':' + trimmed);
        } catch (_) { /* ignore */ }
      });
    " 2>/dev/null)
    if [ -n "$focus_short" ]; then
      focus_segment="🎯 ${focus_short} "
    fi
  fi
fi

if [ -n "$focus_segment" ]; then
  printf '%s' "$focus_segment"
fi

exec node "${CONTEXT_MONITOR}"
