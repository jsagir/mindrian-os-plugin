#!/usr/bin/env bash
# git-ops -- Git operations for room version control
# All operations are guarded by is-enabled check.
# When git is not enabled for a room, every subcommand except commit exits 0
# silently. Plan 400.3-03b (review B1, B2, owner answer OA-4): the commit
# subcommand commits only when the room root has its own repository and only
# the given path; it exits 3 with a 'skipped:' word on stderr (not_a_repo,
# not_own_repo, no_file, nothing_to_commit) and 1 with a 'failed:' word
# (add_failed, commit_failed). Every bash caller uses `|| true`.
#
# Subcommands:
#   is-enabled <room_path>
#   init <room_path>
#   commit <room_path> <file_path> [message]
#   push <room_path>
#   lfs-setup <room_path>
#   status <room_path>
#   get-auto-push <room_path>
#
# First positional argument (before subcommand) can be workspace dir.
# Defaults to $PWD.

set -euo pipefail
# Wave 2 re-review W2R-07: a room's git must never follow an inherited git
# context (a parent hook or a git alias can export these), and a file name
# with *, ?, [ or a leading : must never match other files.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX
export GIT_LITERAL_PATHSPECS=1

# Parse workspace dir -- if first arg is a directory and second arg is a known subcommand
WORK_DIR="$PWD"
if [ $# -ge 2 ]; then
  case "$2" in
    is-enabled|init|commit|push|lfs-setup|status|get-auto-push)
      if [ -d "$1" ]; then
        WORK_DIR="$1"
        shift
      fi
      ;;
  esac
fi

SUBCMD="${1:-}"
shift 2>/dev/null || true

REGISTRY_DIR="${WORK_DIR}/.rooms"
REGISTRY_FILE="${REGISTRY_DIR}/registry.json"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Guard function -- returns 0 if git is enabled for this room path
is_git_enabled() {
  local room_path="${1:-}"
  if [ -z "$room_path" ] || [ ! -d "$room_path" ]; then
    return 1
  fi
  # Check if room_path has .git/ or is inside a git repo
  if git -C "$room_path" rev-parse --git-dir >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

# Plan 400.3-03b (owner answer OA-4): true only when the room root is the top
# level of its own repository. A room inside an enclosing work tree is not.
# Wave 2 Goldfish W2-D-03 / W2-CD-02: no path compare. Git Bash prints
# --show-toplevel as C:/... while pwd -P prints /c/..., so a string compare
# skipped every room on native Windows. An empty --show-prefix inside a work
# tree means the room folder is the top level, in any path form.
is_own_repo() {
  local room_path="${1:-}"
  if ! is_git_enabled "$room_path"; then
    return 1
  fi
  local inside prefix
  inside=$(git -C "$room_path" rev-parse --is-inside-work-tree 2>/dev/null) || return 1
  [ "$inside" = "true" ] || return 1
  prefix=$(git -C "$room_path" rev-parse --show-prefix 2>/dev/null) || return 1
  [ -z "$prefix" ]
}

# Wave 2 Goldfish W2-D-03: the physical path of a folder (symlinks resolved).
real_dir() {
  local d="${1:-}"
  if command -v realpath >/dev/null 2>&1; then
    realpath "$d" 2>/dev/null && return 0
  fi
  (cd "$d" 2>/dev/null && pwd -P)
}

# Wave 2 Goldfish W2-D-03: the file path relative to the room root, with the
# symlinks of both sides resolved (the folder of the file, not the file, so a
# symlinked file is staged as a link). Empty when the file is not in the room.
room_rel_path() {
  local room_path="${1:-}" file_path="${2:-}"
  local room_real dir_real base
  room_real=$(real_dir "$room_path") || return 1
  dir_real=$(real_dir "$(dirname "$file_path")") || return 1
  base=$(basename "$file_path")
  [ -n "$room_real" ] && [ -n "$dir_real" ] || return 1
  if [ "$dir_real" = "$room_real" ]; then
    printf '%s\n' "$base"
    return 0
  fi
  case "$dir_real/" in
    "$room_real"/*) printf '%s\n' "${dir_real#"$room_real"/}/$base" ;;
    *) return 1 ;;
  esac
}

case "$SUBCMD" in
  is-enabled)
    ROOM_PATH="${1:-}"
    if is_git_enabled "$ROOM_PATH"; then
      echo "true"
      exit 0
    else
      echo "false"
      exit 1
    fi
    ;;

  init)
    ROOM_PATH="${1:-}"
    if [ -z "$ROOM_PATH" ]; then
      echo "Usage: git-ops init <room_path>" >&2
      exit 1
    fi
    mkdir -p "$ROOM_PATH"
    git -C "$ROOM_PATH" init >/dev/null 2>&1

    # Create .gitignore
    cat > "${ROOM_PATH}/.gitignore" << 'GITIGNORE'
.DS_Store
*.tmp
.proactive-intelligence.json
GITIGNORE

    # Create .gitattributes with LFS patterns
    cat > "${ROOM_PATH}/.gitattributes" << 'GITATTR'
*.pdf filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.pptx filter=lfs diff=lfs merge=lfs -text
GITATTR

    echo "initialized"
    ;;

  commit)
    ROOM_PATH="${1:-}"
    FILE_PATH="${2:-}"
    MSG="${3:-}"
    # Plan 400.3-03b (review B1, B2, owner answer OA-4): commit only when the
    # room root has its own repository, and only the given path. Every other
    # case exits 3 with a 'skipped:' word; a failed step exits 1 with a
    # 'failed:' word. Nothing is staged or committed in an enclosing repository.
    if ! is_git_enabled "$ROOM_PATH"; then
      echo "skipped: not_a_repo" >&2
      exit 3
    fi
    if ! is_own_repo "$ROOM_PATH"; then
      echo "skipped: not_own_repo" >&2
      exit 3
    fi
    if [ -z "$FILE_PATH" ]; then
      echo "skipped: no_file" >&2
      exit 3
    fi
    # Wave 2 Goldfish W2-D-03: the pathspec is relative to the room root (the
    # top level), with symlinks resolved on both sides. A file outside the
    # room fails as add_failed, the same word as BASE.
    if ! rel_path=$(room_rel_path "$ROOM_PATH" "$FILE_PATH") || [ -z "$rel_path" ]; then
      echo "failed: add_failed" >&2
      exit 1
    fi
    # Auto-generate message if not provided
    if [ -z "$MSG" ]; then
      # Extract section name and filename for provenance
      section=$(echo "$rel_path" | cut -d'/' -f1)
      filename=$(basename "$FILE_PATH" .md)
      MSG="${section}: ${filename}"
    fi
    # Stage the specific file only (pathspec).
    if ! git -C "$ROOM_PATH" add -- "$rel_path" 2>/dev/null; then
      echo "failed: add_failed" >&2
      exit 1
    fi
    # No staged change for that path: nothing to commit.
    if git -C "$ROOM_PATH" diff --cached --quiet -- "$rel_path" 2>/dev/null; then
      echo "skipped: nothing_to_commit" >&2
      exit 3
    fi
    # Commit that path only (--no-verify for auto-commits); a change staged
    # elsewhere in the repository stays staged and is not in this commit.
    if ! git -C "$ROOM_PATH" commit --no-verify -m "$MSG" -- "$rel_path" >/dev/null 2>&1; then
      echo "failed: commit_failed" >&2
      exit 1
    fi
    # Check auto_push setting
    auto_push=$("${SCRIPT_DIR}/git-ops" get-auto-push "$ROOM_PATH" 2>/dev/null || echo "off")
    if [ "$auto_push" = "auto" ]; then
      # Wave 2 Goldfish W2-D-02: the background push gets no pipe of the
      # caller. A child that keeps stdout or stderr open makes the caller
      # (commitArtifact, spawnSync) wait for the network push.
      "${SCRIPT_DIR}/git-ops" push "$ROOM_PATH" >/dev/null 2>&1 </dev/null &
    fi
    ;;

  push)
    ROOM_PATH="${1:-}"
    # Guard: exit 0 silently if git is not enabled
    if ! is_git_enabled "$ROOM_PATH"; then
      exit 0
    fi
    # Check if remote exists
    if ! git -C "$ROOM_PATH" remote get-url origin >/dev/null 2>&1; then
      exit 0
    fi
    # Push in background, non-blocking. Wave 2 Goldfish W2-D-02: no pipe of
    # the caller stays open, so the caller does not wait for the network.
    git -C "$ROOM_PATH" push origin HEAD >/dev/null 2>&1 </dev/null &
    echo "pushed"
    ;;

  lfs-setup)
    ROOM_PATH="${1:-}"
    # Guard: exit 0 silently if git is not enabled
    if ! is_git_enabled "$ROOM_PATH"; then
      exit 0
    fi
    # Check if git lfs is available
    if git lfs version >/dev/null 2>&1; then
      git -C "$ROOM_PATH" lfs install --local 2>/dev/null
      echo "lfs-configured"
    else
      echo "Git LFS not installed -- large files will be committed normally" >&2
    fi
    exit 0
    ;;

  status)
    ROOM_PATH="${1:-}"
    # Guard: print disabled status and exit 0
    if ! is_git_enabled "$ROOM_PATH"; then
      echo '{"enabled": false}'
      exit 0
    fi
    # Get remote URL
    remote=$(git -C "$ROOM_PATH" remote get-url origin 2>/dev/null || echo "null")
    if [ "$remote" = "null" ]; then
      remote_json="null"
    else
      remote_json="\"$remote\""
    fi
    # Get auto_push setting
    auto_push=$("${SCRIPT_DIR}/git-ops" get-auto-push "$ROOM_PATH" 2>/dev/null || echo "off")
    # Check LFS
    if git lfs version >/dev/null 2>&1 && [ -f "${ROOM_PATH}/.git/hooks/pre-push" ] 2>/dev/null; then
      lfs="true"
    else
      lfs="false"
    fi
    # Count dirty files
    dirty=$(git -C "$ROOM_PATH" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    echo "{\"enabled\": true, \"remote\": ${remote_json}, \"auto_push\": \"${auto_push}\", \"lfs\": ${lfs}, \"dirty_files\": ${dirty}}"
    ;;

  get-auto-push)
    ROOM_PATH="${1:-}"
    if [ ! -f "$REGISTRY_FILE" ]; then
      echo "off"
      exit 0
    fi
    # Find room name by matching path in registry. The 3 paths arrive via
    # sys.argv, never pasted into this program text (quick 261030-eo7, N2; the
    # scripts/resolve-room argv model).
    python3 -c "
import json, os, sys
try:
    with open(sys.argv[1]) as f:
        reg = json.load(f)
    room_path = os.path.realpath(sys.argv[2])
    for name, room in reg.get('rooms', {}).items():
        rp = room.get('path', '')
        # Try both absolute and relative paths
        if os.path.realpath(rp) == room_path or os.path.realpath(os.path.join(sys.argv[3], rp)) == room_path:
            print(room.get('auto_push', 'off'))
            sys.exit(0)
    print('off')
except Exception:
    print('off')
" "$REGISTRY_FILE" "$ROOM_PATH" "$WORK_DIR" 2>/dev/null || echo "off"
    ;;

  *)
    echo "Usage: git-ops <is-enabled|init|commit|push|lfs-setup|status|get-auto-push> [args...]" >&2
    exit 1
    ;;
esac
