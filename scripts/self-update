#!/usr/bin/env bash
set -euo pipefail

# self-update: Atomic MindrianOS plugin update
# Clones latest from GitHub, validates, swaps in place.
# Bypasses marketplace cache entirely -- single source of truth.
#
# Output protocol (first line):
#   UP_TO_DATE          -- already on latest
#   UPDATE_AVAILABLE    -- newer version found, details follow
#   UPDATED             -- successfully updated
#   UPDATE_FAILED       -- something went wrong
#   CHECK_FAILED        -- couldn't reach GitHub
#
# Usage:
#   bash scripts/self-update check     # check only, no install
#   bash scripts/self-update install    # check + install if available
#   bash scripts/self-update force      # reinstall even if same version

MODE="${1:-check}"
REPO_URL="https://github.com/jsagir/mindrian-os-plugin.git"
CHANGELOG_URL="https://raw.githubusercontent.com/jsagir/mindrian-os-plugin/main/CHANGELOG.md"

# --- Resolve paths ---
PLUGIN_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Find the cache directory where Claude Code stores the installed plugin
# This is the directory we need to replace
CACHE_DIR=""
# Check if we're running from cache (normal case for installed users)
if echo "$PLUGIN_ROOT" | grep -q "plugins/cache"; then
  CACHE_DIR="$PLUGIN_ROOT"
# Check if we're running from source (developer case)
elif [ -d "$HOME/.claude/plugins/cache/mindrian-marketplace/mos" ]; then
  # Find the actual cache dir (version-numbered)
  CACHE_DIR=$(find "$HOME/.claude/plugins/cache/mindrian-marketplace/mos" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | head -1)
fi

# Fallback: use PLUGIN_ROOT as the install target
if [ -z "$CACHE_DIR" ]; then
  CACHE_DIR="$PLUGIN_ROOT"
fi

# --- Read current version ---
CURRENT_VERSION=""
if [ -f "$CACHE_DIR/.claude-plugin/plugin.json" ]; then
  CURRENT_VERSION=$(python3 -c "import json; print(json.load(open('$CACHE_DIR/.claude-plugin/plugin.json'))['version'])" 2>/dev/null || echo "0.0.0")
elif [ -f "$PLUGIN_ROOT/.claude-plugin/plugin.json" ]; then
  CURRENT_VERSION=$(python3 -c "import json; print(json.load(open('$PLUGIN_ROOT/.claude-plugin/plugin.json'))['version'])" 2>/dev/null || echo "0.0.0")
else
  CURRENT_VERSION="0.0.0"
fi

# --- Check latest version from GitHub ---
REMOTE_CHANGELOG=""
if ! REMOTE_CHANGELOG=$(curl -sf --max-time 10 "$CHANGELOG_URL" 2>/dev/null); then
  echo "CHECK_FAILED"
  echo "Could not reach GitHub. Check your connection."
  exit 0
fi

LATEST_VERSION=$(echo "$REMOTE_CHANGELOG" | sed -n 's/^## \[\([0-9]*\.[0-9]*\.[0-9]*\)\].*/\1/p' | head -1)

if [ -z "$LATEST_VERSION" ]; then
  echo "CHECK_FAILED"
  echo "Could not parse version from remote changelog."
  exit 0
fi

# --- Compare versions ---
if [ "$MODE" != "force" ]; then
  LOWER=$(printf '%s\n%s' "$CURRENT_VERSION" "$LATEST_VERSION" | sort -V | head -1)

  if [ "$CURRENT_VERSION" = "$LATEST_VERSION" ]; then
    echo "UP_TO_DATE"
    echo "v${CURRENT_VERSION}"
    exit 0
  fi

  if [ "$LOWER" != "$CURRENT_VERSION" ]; then
    # Current is newer (dev build)
    echo "UP_TO_DATE"
    echo "v${CURRENT_VERSION} (ahead of v${LATEST_VERSION})"
    exit 0
  fi
fi

# --- Update is available ---
CHANGELOG_DIFF=$(echo "$REMOTE_CHANGELOG" | sed -n "/^## \[${LATEST_VERSION}\]/,/^## \[${CURRENT_VERSION}\]/p" | head -n -1)

if [ "$MODE" = "check" ]; then
  echo "UPDATE_AVAILABLE"
  echo "CURRENT=${CURRENT_VERSION}"
  echo "LATEST=${LATEST_VERSION}"
  echo "CACHE_DIR=${CACHE_DIR}"
  echo "---CHANGELOG---"
  echo "$CHANGELOG_DIFF"
  exit 0
fi

# --- Install mode: clone and swap ---
echo "UPDATING"
echo "CURRENT=${CURRENT_VERSION}"
echo "LATEST=${LATEST_VERSION}"

TEMP_DIR=$(mktemp -d)
trap "rm -rf '$TEMP_DIR'" EXIT

# Clone latest (shallow, fast)
echo "STATUS=cloning"
if ! git clone --depth 1 --single-branch --branch main "$REPO_URL" "$TEMP_DIR/plugin" 2>/dev/null; then
  echo "UPDATE_FAILED"
  echo "Git clone failed. Check your connection or GitHub access."
  exit 0
fi

# Validate the downloaded plugin
echo "STATUS=validating"
DOWNLOADED_VERSION=$(python3 -c "import json; print(json.load(open('$TEMP_DIR/plugin/.claude-plugin/plugin.json'))['version'])" 2>/dev/null || echo "")

if [ -z "$DOWNLOADED_VERSION" ]; then
  echo "UPDATE_FAILED"
  echo "Downloaded plugin has no valid plugin.json"
  exit 0
fi

# Run Claude plugin validation if available
if command -v claude &>/dev/null; then
  VALIDATION=$(claude plugin validate "$TEMP_DIR/plugin" 2>&1 || true)
  if echo "$VALIDATION" | grep -q "Validation failed"; then
    echo "UPDATE_FAILED"
    echo "Downloaded plugin failed validation:"
    echo "$VALIDATION"
    exit 0
  fi
fi

# Count critical files
CMD_COUNT=$(ls "$TEMP_DIR/plugin/commands/"*.md 2>/dev/null | wc -l)
if [ "$CMD_COUNT" -lt 50 ]; then
  echo "UPDATE_FAILED"
  echo "Downloaded plugin has only $CMD_COUNT commands (expected 60+). Aborting."
  exit 0
fi

# --- Full backup for rollback ---
echo "STATUS=backing_up"
BACKUP_DIR="$HOME/.mindrian/backups/v${CURRENT_VERSION}-$(date +%Y%m%d%H%M%S)"
mkdir -p "$BACKUP_DIR"

# FULL backup of current install (enables rollback)
cp -a "$CACHE_DIR/." "$BACKUP_DIR/full/" 2>/dev/null || true

# Also detect and separately save user modifications
if [ -f "$CACHE_DIR/.checksums" ]; then
  while IFS='  ' read -r expected_hash filepath; do
    if [ -f "$CACHE_DIR/$filepath" ]; then
      actual_hash=$(sha256sum "$CACHE_DIR/$filepath" 2>/dev/null | cut -d' ' -f1)
      if [ "$actual_hash" != "$expected_hash" ]; then
        mkdir -p "$BACKUP_DIR/patches/$(dirname "$filepath")"
        cp "$CACHE_DIR/$filepath" "$BACKUP_DIR/patches/$filepath"
      fi
    fi
  done < "$CACHE_DIR/.checksums"
fi

# Write rollback script
cat > "$BACKUP_DIR/rollback.sh" << 'ROLLBACK_EOF'
#!/usr/bin/env bash
set -euo pipefail
BACKUP_FULL="$(cd "$(dirname "$0")/full" && pwd)"
TARGET="${1:-}"
if [ -z "$TARGET" ]; then
  echo "Usage: bash rollback.sh <plugin-cache-dir>"
  echo "  e.g. bash rollback.sh ~/.claude/plugins/cache/mindrian-marketplace/mos/1.8.4"
  exit 1
fi
echo "Rolling back to $(cat "$BACKUP_FULL/.claude-plugin/plugin.json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["version"])')"
rm -rf "$TARGET"/*
cp -a "$BACKUP_FULL/." "$TARGET/"
echo "Rollback complete. Restart Claude Code."
ROLLBACK_EOF
chmod +x "$BACKUP_DIR/rollback.sh"

echo "STATUS=full_backup_complete"

# --- Atomic swap with rollback on failure ---
echo "STATUS=installing"

# Swap strategy: copy new files alongside old, then remove old.
# If anything fails, rollback from backup.
SWAP_OK=true

# Step 1: Copy new files into a staging area inside cache dir
STAGE="$CACHE_DIR/.update-stage"
rm -rf "$STAGE"
mkdir -p "$STAGE"
cp -a "$TEMP_DIR/plugin/." "$STAGE/" 2>/dev/null || SWAP_OK=false
rm -rf "$STAGE/.git"

if [ "$SWAP_OK" = false ]; then
  echo "UPDATE_FAILED"
  echo "Could not stage new files. Current install is untouched."
  rm -rf "$STAGE"
  exit 0
fi

# Step 2: Verify staged copy is valid
STAGED_CMDS=$(ls "$STAGE/commands/"*.md 2>/dev/null | wc -l)
if [ "$STAGED_CMDS" -lt 50 ]; then
  echo "UPDATE_FAILED"
  echo "Staged copy has only $STAGED_CMDS commands. Aborting. Current install untouched."
  rm -rf "$STAGE"
  exit 0
fi

# Step 3: Remove old files (preserve .env, node_modules)
PRESERVE_LIST=(".env" "node_modules" ".update-stage")
for item in "$CACHE_DIR"/* "$CACHE_DIR"/.*; do
  bname=$(basename "$item")
  if [ "$bname" = "." ] || [ "$bname" = ".." ]; then continue; fi
  skip=false
  for preserve in "${PRESERVE_LIST[@]}"; do
    if [ "$bname" = "$preserve" ]; then skip=true; break; fi
  done
  if [ "$skip" = false ]; then
    rm -rf "$item" 2>/dev/null || true
  fi
done

# Step 4: Move staged files into place
for item in "$STAGE"/* "$STAGE"/.*; do
  bname=$(basename "$item")
  if [ "$bname" = "." ] || [ "$bname" = ".." ] || [ "$bname" = ".update-stage" ]; then continue; fi
  mv "$item" "$CACHE_DIR/" 2>/dev/null || true
done
rm -rf "$STAGE"

# Step 5: Post-swap validation -- if this fails, ROLLBACK
POST_CMDS=$(ls "$CACHE_DIR/commands/"*.md 2>/dev/null | wc -l)
POST_VERSION=$(python3 -c "import json; print(json.load(open('$CACHE_DIR/.claude-plugin/plugin.json'))['version'])" 2>/dev/null || echo "")

if [ "$POST_CMDS" -lt 50 ] || [ -z "$POST_VERSION" ]; then
  echo "STATUS=rollback"
  echo "Post-swap validation failed ($POST_CMDS commands, version='$POST_VERSION'). Rolling back..."
  # ROLLBACK: restore from full backup
  rm -rf "$CACHE_DIR"/*
  cp -a "$BACKUP_DIR/full/." "$CACHE_DIR/" 2>/dev/null || true
  echo "UPDATE_FAILED"
  echo "Update failed post-swap validation. Rolled back to v${CURRENT_VERSION}. Your install is safe."
  exit 0
fi

# Generate checksums for future modification detection
echo "STATUS=checksums"
cd "$CACHE_DIR"
find . -type f \( -name "*.md" -o -name "*.json" -o -name "*.cjs" -o -name "*.sh" \) \
  ! -path "./.git/*" ! -path "./node_modules/*" \
  -exec sha256sum {} \; > .checksums 2>/dev/null || true

# Install npm dependencies if package.json exists
if [ -f "$CACHE_DIR/package.json" ]; then
  echo "STATUS=npm_install"
  cd "$CACHE_DIR" && npm install --production --silent 2>/dev/null || true
fi

# Clear update check cache so status line stops showing update badge
rm -f "$HOME/.mindrian/bridge/update-check.json" 2>/dev/null || true

# --- Update marketplace cache version pointer ---
# Find and update the marketplace's cached version so `claude plugin list` shows correct version
MARKETPLACE_CACHE=$(find "$HOME/.claude" -path "*/mindrian-marketplace*marketplace.json" 2>/dev/null | head -1)
if [ -n "$MARKETPLACE_CACHE" ]; then
  python3 -c "
import json
with open('$MARKETPLACE_CACHE') as f:
    m = json.load(f)
m['plugins'][0]['version'] = '$DOWNLOADED_VERSION'
with open('$MARKETPLACE_CACHE', 'w') as f:
    json.dump(m, f, indent=2)
    f.write('\n')
" 2>/dev/null || true
fi

echo "UPDATED"
echo "OLD_VERSION=${CURRENT_VERSION}"
echo "NEW_VERSION=${DOWNLOADED_VERSION}"
echo "BACKUP=${BACKUP_DIR}"
echo "COMMANDS=$(ls "$CACHE_DIR/commands/"*.md 2>/dev/null | wc -l)"
echo "---CHANGELOG---"
echo "$CHANGELOG_DIFF"
